---
const casos = [
  { id: 'caso-anii', img: '/img/alva/cases/anii.webp', w: 1000, h: 555, categoria: 'Estrategia & campaña institucional', nombre: 'Promover la innovación', cliente: 'ANII — Agencia Nacional de Investigación e Innovación' },
  { id: 'caso-correo', img: '/img/alva/cases/correo.webp', w: 960, h: 660, categoria: 'Diagnóstico & plataforma de marca', nombre: 'Una campaña institucional pensada para evolucionar', cliente: 'Correo Uruguayo' },
  { id: 'caso-heritage', img: '/img/alva/cases/heritage.webp', w: 565, h: 790, categoria: 'Campañas institucionales y comerciales', nombre: 'Comunicación integral de marca y producto', cliente: 'Banque Heritage' },
  { id: 'caso-carve', img: '/img/alva/cases/carve.webp', w: 430, h: 580, categoria: 'Campaña multimedios · Alcance nacional', nombre: 'Noticias que llegan a tiempo', cliente: 'Carve 850' },
  { id: 'caso-elsie', img: '/img/alva/cases/elsie.webp', w: 900, h: 520, categoria: 'Estrategia de sensibilización', nombre: 'Historias de Paz', cliente: 'Ministerio de Defensa · Proyecto Elsie' },
  { id: 'caso-farmashop', img: '/img/alva/cases/farmashop.webp', w: 900, h: 820, categoria: 'Planificación & campaña de movilidad sostenible', nombre: 'Delivery más verde', cliente: 'Farmashop' },
];
---
<section id="experiencia" class="py-2xl bg-ink text-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <p class="reveal font-bold text-eyebrow uppercase text-dark-muted mb-3">Experiencia</p>
    <h2 class="reveal font-bold text-h3 max-w-[560px] mb-md">Proyectos hechos <em>desde una mirada distinta.</em></h2>

    <div class="reveal grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-9">
      {casos.map(c => (
        <button class="caso-card group text-left w-full" data-modal={c.id}>
          <span class="block aspect-[4/3] overflow-hidden bg-ink-soft rounded-sm">
            <img src={c.img} alt="" loading="lazy" width={c.w} height={c.h} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]" />
          </span>
          <span class="block pt-3.5">
            <span class="block text-[.7rem] font-bold uppercase tracking-[0.08em] text-red mb-1.5">{c.categoria}</span>
            <span class="block text-base font-bold leading-snug mb-1">{c.nombre}</span>
            <span class="block text-sm text-dark-muted">{c.cliente}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Case modal -->
<div class="modal-overlay fixed inset-0 z-[500] bg-ink/72 flex items-center justify-center p-6" id="modalOverlay">
  <div class="modal-box relative bg-white rounded-[20px] overflow-hidden w-full max-w-[920px] max-h-[88vh] overflow-y-auto grid grid-cols-1 md:grid-cols-[1.1fr_1fr]" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button class="modal-close absolute top-4.5 right-4.5 z-10 w-9.5 h-9.5 rounded-full bg-ink/6 flex items-center justify-center text-2xl leading-none" id="modalClose" aria-label="Cerrar">&times;</button>
    <div class="bg-paper-dim min-h-[200px] md:min-h-[260px]"><img id="modalImg" src="" alt="" class="w-full h-full object-cover" /></div>
    <div class="p-9">
      <p class="text-[.72rem] font-bold uppercase tracking-[0.08em] text-red mb-2" id="modalCategoria"></p>
      <h3 id="modalTitle" class="text-2xl font-bold mt-2 mb-1.5"></h3>
      <p class="text-muted font-semibold mb-4.5" id="modalCliente"></p>
      <p class="leading-relaxed" id="modalDesc"></p>
      <ul class="flex flex-wrap gap-2 mt-5.5" id="modalTags"></ul>
    </div>
  </div>
</div>
