---
import CtaHablemos from './CtaHablemos.astro';
const items = [
  { n: '01', title: 'Estrategia y creatividad', copy: 'Trabajamos con una base estratégica que asegura que cada acción tenga sentido, medición y resultados concretos. Es comunicación pensada para funcionar.' },
  { n: '02', title: 'Mirada integrada', copy: 'Combina comunicación, sostenibilidad e inclusión en un mismo enfoque. Eso permite construir marcas relevantes hoy, alineadas con los cambios culturales.' },
  { n: '03', title: 'Equipo sólido y con experiencia', copy: 'Un equipo multidisciplinario con experiencia en campañas de alcance nacional, proyectos complejos y clientes diversos. Capacidad real de ejecutar, adaptarse y sostener procesos en el tiempo.' },
];
---
<section class="py-2xl bg-ink text-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <p class="reveal font-bold text-eyebrow uppercase text-dark-muted mb-5">¿Por qué Alva?</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-11 mt-5">
      {items.map(it => (
        <div class="reveal">
          <span class="block font-serif italic font-semibold text-yellow text-2xl mb-5">{it.n}</span>
          <h3 class="font-bold text-xl mb-3.5">{it.title}</h3>
          <p class="text-dark-muted">{it.copy}</p>
        </div>
      ))}
    </div>
    <CtaHablemos variant="dark" align="left" />
  </div>
</section>
