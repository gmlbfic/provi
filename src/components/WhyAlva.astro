---
import { whyAlva } from '../data/site';
---

<section id="por-que-alva" class="bg-paper py-20 md:py-28">
  <div class="container-alva">
    <p class="fade-up eyebrow mb-14 text-ink/50 md:mb-20">{whyAlva.heading}</p>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-0 md:divide-x md:divide-violet/25">
      {whyAlva.items.map((item, i) => (
        <div class="fade-up md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="font-serif text-lg italic text-violet">0{i + 1}</span>
          <h3 class="mt-4 font-display text-2xl font-medium leading-tight tracking-tightest text-violet md:text-3xl">
            {item.name}
          </h3>
          <p class="mt-4 max-w-xs font-display text-base leading-relaxed text-ink/70">
            {item.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
