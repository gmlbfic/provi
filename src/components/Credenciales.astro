---
import CtaHablemos from './CtaHablemos.astro';
const stat = { mark: '+10', copy: 'años trabajando con instituciones públicas y empresas privadas.' };
const items = [
  'Especialistas en campañas de sensibilización y cambio cultural.',
  'Experiencia en temas complejos: sostenibilidad, género, salud y energía.',
  'Capacidad de traducir lo técnico en mensajes claros.',
];
---
<section id="credenciales" class="py-xl bg-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-9 border-t border-black/10 pt-11">
      <div class="reveal">
        <span class="block font-serif italic font-semibold text-4xl leading-none mb-3 text-red">{stat.mark}</span>
        <p class="max-w-[22ch]">{stat.copy}</p>
      </div>
      {items.map(copy => (
        <div class="reveal">
          <span class="block w-5 h-px bg-ink/40 mb-4.5 mt-4"></span>
          <p class="max-w-[22ch]">{copy}</p>
        </div>
      ))}
    </div>

    <CtaHablemos variant="light" align="left" />
  </div>
</section>
