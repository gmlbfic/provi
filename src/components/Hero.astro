---
---
<section id="alva" class="hero relative min-h-screen flex items-center bg-ink text-paper overflow-hidden pt-32 pb-20">
  <!-- Big soft color shapes — the one bold risk in the composition -->
  <div class="absolute z-0 pointer-events-none -right-[18%] -top-[22%] w-[52vw] h-[52vw] max-w-[760px] max-h-[760px] rounded-full opacity-70 blur-[90px] mix-blend-screen" style="background:radial-gradient(circle at 35% 35%, #E5411F, transparent 70%);" aria-hidden="true"></div>
  <div class="absolute z-0 pointer-events-none -left-[12%] bottom-[-20%] w-[42vw] h-[42vw] max-w-[620px] max-h-[620px] rounded-full opacity-60 blur-[100px] mix-blend-screen" style="background:radial-gradient(circle at 60% 40%, #6736D1, transparent 70%);" aria-hidden="true"></div>

  <div class="reveal-draw absolute right-[-90px] left-auto bottom-[-20px] top-auto w-[200px] h-[260px] opacity-60 md:right-[-20px] md:top-[100px] md:bottom-0 md:h-auto md:w-[min(30vw,340px)] md:opacity-90 pointer-events-none z-[1]" id="heroLoops" aria-hidden="true">
    <svg viewBox="0 0 320 640" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <g fill="none" stroke-width="7" stroke-linecap="round">
        <path pathLength="1" stroke="#E5411F" d="M20 40 C -10 10, 40 -10, 55 25 C 68 55, 100 65, 130 40 S 190 15, 210 45"/>
        <path pathLength="1" stroke="#75BFFF" d="M0 130 C -30 160, -30 210, 5 220 C 40 230, 50 180, 25 160 C 0 140, -20 170, -40 210"/>
        <path pathLength="1" stroke="#FEF373" d="M60 260 C 20 275, 10 320, 45 335 C 80 350, 100 300, 70 285 C 100 270, 130 285, 145 320"/>
        <path pathLength="1" stroke="#54B86F" d="M140 380 C 110 400, 110 445, 150 450 C 190 455, 195 405, 160 400 C 195 400, 210 420, 205 455"/>
        <path pathLength="1" stroke="#FFCDF3" d="M20 500 C -10 520, -10 560, 25 570 C 60 580, 90 555, 105 585 C 60 570, 40 600, 65 630"/>
      </g>
    </svg>
  </div>

  <!-- Floating particles -->
  <span class="floaty absolute z-[1] top-[22%] right-[28%] w-3 h-3 rounded-full bg-yellow hidden md:block" aria-hidden="true" style="animation-delay:0s"></span>
  <span class="floaty absolute z-[1] top-[68%] right-[12%] w-2 h-2 rounded-sm bg-green hidden md:block" aria-hidden="true" style="animation-delay:1.1s"></span>
  <span class="floaty absolute z-[1] top-[42%] right-[6%] w-4 h-4 rounded-full border-2 border-blue hidden md:block" aria-hidden="true" style="animation-delay:2s"></span>

  <div class="relative z-[2] mx-auto max-w-[1240px] px-6 w-full">
    <div class="stagger max-w-[920px]">
      <p class="reveal font-bold text-eyebrow uppercase text-dark-muted mb-5">Ideas que nos mueven</p>
      <h1 class="reveal font-extrabold text-display mb-8">
        Hacemos cosas <em>distintas</em><br />
        porque vemos las cosas <em class="text-yellow">distinto</em>.
      </h1>
      <p class="reveal text-[clamp(1.05rem,1.6vw,1.3rem)] text-dark-muted max-w-[560px] mb-10">
        Alva es una agencia de comunicación y publicidad independiente. Unimos estrategia
        y creatividad para que las cosas pasen — para instituciones y marcas que necesitan
        comunicar temas complejos y liderar un cambio cultural real.
      </p>
      <div class="reveal flex flex-wrap gap-4">
        <a href="#experiencia" class="inline-flex items-center gap-2 rounded-full bg-red px-7 py-3.5 text-sm font-bold text-white transition-transform duration-300 hover:-translate-y-0.5 hover:bg-red-deep">Ver nuestro trabajo</a>
      </div>
    </div>
  </div>

  <a href="#credenciales" class="scroll-cue-btn group absolute left-1/2 ml-[-28px] bottom-8 z-[2] w-14 h-14 rounded-full bg-red flex items-center justify-center hidden sm:flex" aria-label="Bajar a la siguiente sección">
    <svg class="scroll-cue-arrow w-5 h-5 text-white" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v14M4 11l6 6 6-6"/></svg>
  </a>
</section>
