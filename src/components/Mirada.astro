---
import CtaHablemos from './CtaHablemos.astro';
---
<section id="mirada" class="py-2xl bg-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <p class="reveal font-bold text-eyebrow uppercase text-muted mb-5">Nuestra mirada</p>
    <h2 class="reveal font-bold text-h2 max-w-[820px] mb-6">En todo lo que hacemos integramos <em>tres dimensiones</em>.</h2>

    <div class="reveal flex items-center gap-4 mb-lg">
      <span class="h-px flex-1 bg-black/12"></span>
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-ink">
        <img src="/img/alva/alva-logo.png" alt="Alva" width="40" height="16" class="w-9 rounded" />
      </span>
      <span class="h-px flex-1 bg-black/12"></span>
    </div>

    <div class="reveal grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-black/12">
      <div class="pt-8 md:pt-0 md:pr-10">
        <span class={`inline-flex w-11 h-11 mb-5 text-red`} aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="14" r="7"/><path d="M8 40c0-9 7-15 16-15s16 6 16 15"/></svg>
        </span>
        <h3 class="font-bold text-xl mb-2">Mirada social</h3>
        <p class="text-muted">Ponemos a las personas en el centro.</p>
      </div>
      <div class="pt-8 md:pt-0 md:px-10">
        <span class="inline-flex w-11 h-11 mb-5 text-violet" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="12" r="6"/><circle cx="32" cy="12" r="6"/><path d="M6 38c0-7.5 5.5-13 13-13M42 38c0-7.5-5.5-13-13-13"/></svg>
        </span>
        <h3 class="font-bold text-xl mb-2">Mirada de género y diversidad</h3>
        <p class="text-muted">Comunicamos de forma inclusiva.</p>
      </div>
      <div class="pt-8 md:pt-0 md:pl-10">
        <span class="inline-flex w-11 h-11 mb-5 text-green" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"/><path d="M7 24h34M24 7c6 5 6 29 0 34M24 7c-6 5-6 29 0 34"/></svg>
        </span>
        <h3 class="font-bold text-xl mb-2">Mirada sostenible</h3>
        <p class="text-muted">Pensamos en el impacto de lo que hacemos.</p>
      </div>
    </div>

    <CtaHablemos variant="light" align="right" />
  </div>
</section>
