---
import CtaHablemos from './CtaHablemos.astro';
---
<section id="clientes" class="py-2xl bg-white">
  <div class="mx-auto max-w-[1240px] px-6">
    <p class="reveal font-bold text-eyebrow uppercase text-muted mb-5">Clientes</p>
    <h2 class="reveal font-bold text-h2 max-w-[820px] mb-11">Confían en nosotros marcas, empresas y organismos <em>de distintos sectores.</em></h2>

    <div class="reveal flex gap-2.5 flex-wrap mb-9" role="tablist" aria-label="Grupos de clientes">
      <button class="clientes-tab is-active rounded-full px-5.5 py-3 font-bold text-sm bg-ink text-white transition-colors duration-300" role="tab" aria-selected="true" data-target="clientes-privados">Marcas y organizaciones</button>
      <button class="clientes-tab rounded-full px-5.5 py-3 font-bold text-sm bg-paper text-muted transition-colors duration-300" role="tab" aria-selected="false" data-target="clientes-publicos">Organismos públicos</button>
    </div>

    <div class="reveal">
      <div class="clientes-panel" id="clientes-privados" role="tabpanel">
        <img src="/img/alva/clientes/privados.jpg" alt="Logos de marcas, empresas privadas y organizaciones que trabajaron con Alva: BID, Tumo, ONU Mujeres, Proyecto Elsie, Unicef, Pacto Global, Nestlé, Nespresso, Warner Bros, SUAT, Forbes, Megalabs, Comisión Honoraria para la Salud Cardiovascular, Banque Heritage, Arcor, Aguila, Red Hat, AIVA, Fe y Alegría, Casa Zorrilla, Carve 850, La 1010, Monte Carlo, Radiocero, La Pasiva, Braglia, Vinoteca Club, Mercant&Esteves, Castellán, Eyecue, Paullier, OMEU, Prolesa, BASF, Gerdau y Amnistía Internacional." loading="lazy" width="1600" height="711" class="w-full h-auto rounded-sm grayscale-[15%]" />
      </div>
      <div class="clientes-panel" id="clientes-publicos" role="tabpanel" hidden>
        <img src="/img/alva/clientes/publicos.jpg" alt="Logos de organismos e instituciones públicas que trabajaron con Alva: Ministerio de Industria Energía y Minería, eficiencia energética, Ministerio de Desarrollo Social, Ministerio del Interior, DCAF, Ministerio de Transporte y Obras Públicas, Ministerio de Salud Pública, Ministerio de Ambiente, Ministerio de Ganadería Agricultura y Pesca, Cámara de Industrias del Uruguay, Plan Vale Uruguay, Uruguay XXI, ANII, INIA, UTEC, UNASEV, OPS, Correo Uruguayo, Fondo Nacional de Recursos, Movés, Intendencia de Montevideo, ECH y Uruguay Innovation Hub." loading="lazy" width="1600" height="711" class="w-full h-auto rounded-sm grayscale-[15%]" />
      </div>
    </div>

    <CtaHablemos variant="light" align="left" />
  </div>
</section>
