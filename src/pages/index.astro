---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Credenciales from '../components/Credenciales.astro';
import Mirada from '../components/Mirada.astro';
import PorQue from '../components/PorQue.astro';
import Servicios from '../components/Servicios.astro';
import Experiencia from '../components/Experiencia.astro';
import Reconocimientos from '../components/Reconocimientos.astro';
import Equipo from '../components/Equipo.astro';
import Clientes from '../components/Clientes.astro';
import Alianzas from '../components/Alianzas.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Credenciales />
    <Mirada />
    <PorQue />
    <Servicios />
    <Experiencia />
    <Reconocimientos />
    <Equipo />
    <Clientes />
    <Alianzas />
    <Contacto />
  </main>
  <Footer />
</Base>
