---
import { Image } from 'astro:assets';
import { awards } from '../data/site';
import effieGold from '../assets/awards/effie-gold.png';
---

<section id="reconocimientos" class="border-b border-paper/10 bg-ink py-20 text-paper md:py-28">
  <div class="container-alva">
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-8">
      <div class="fade-up md:col-span-5">
        <p class="eyebrow mb-6 text-gold">{awards.heading}</p>
        <p class="max-w-sm font-display text-xl leading-relaxed text-paper/75 md:text-2xl">
          {awards.text}
        </p>
      </div>

      <div class="fade-up md:col-span-7">
        <div class="flex aspect-[16/10] items-center justify-center border border-paper/10 bg-paper/[0.03] p-10">
          <Image
            src={effieGold}
            alt="Estatuilla de reconocimiento obtenida por Alva"
            width={520}
            height={520}
            loading="lazy"
            class="h-full w-auto max-w-full object-contain drop-shadow-[0_0_40px_rgba(198,161,91,0.15)]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
