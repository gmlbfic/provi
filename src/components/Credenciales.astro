---
import CtaHablemos from './CtaHablemos.astro';
const items = [
  { color: 'text-red', copy: 'años trabajando con instituciones públicas y empresas privadas.', mark: '+10' },
  { color: 'text-violet', copy: 'Especialistas en campañas de sensibilización y cambio cultural.', mark: '·' },
  { color: 'text-green', copy: 'Experiencia en temas complejos: sostenibilidad, género, salud y energía.', mark: '·' },
  { color: 'text-blue', copy: 'Capacidad de traducir lo técnico en mensajes claros.', mark: '·' },
];
---
<section id="credenciales" class="py-xl bg-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-9 border-t border-black/10 pt-11">
      {items.map(it => (
        <div class="reveal">
          <span class={`block font-serif italic font-semibold text-4xl leading-none mb-3 ${it.color}`}>{it.mark}</span>
          <p class="max-w-[22ch]">{it.copy}</p>
        </div>
      ))}
    </div>

    <CtaHablemos variant="light" align="left" />
  </div>
</section>
