---
import { nav, siteMeta } from '../data/site';
import alvaIconWhite from '../assets/logos/alva-icon-white.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-paper/10 bg-ink py-10 text-paper">
  <div class="container-alva flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <img src={alvaIconWhite.src} alt={siteMeta.fullName} class="h-9 w-auto" width="180" height="60" />

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Navegación de pie de página">
      {nav.map((item) => (
        <a href={item.href} class="link-underline font-display text-xs uppercase tracking-[0.14em] text-paper/60 hover:text-paper">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex flex-col gap-1 font-display text-xs text-paper/45 md:items-end">
      <a href={`mailto:${siteMeta.email}`} class="link-underline text-paper/70 hover:text-paper">{siteMeta.email}</a>
      <p>{siteMeta.locality}, {siteMeta.country}</p>
      <p>© {year} {siteMeta.fullName}</p>
    </div>
  </div>
</footer>
