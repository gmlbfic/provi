---
import CtaHablemos from './CtaHablemos.astro';

const team = [
  { img: 'ariceta', name: 'Mag. Fernanda Ariceta', rol: 'Dirección general y Dirección de Estrategia', anos: '+23 años de experiencia' },
  { img: 'lopez-balinas', name: 'Mag. Gonzalo López Baliñas', rol: 'Dirección Creativa Ejecutiva', anos: '+18 años de experiencia' },
  { img: 'braglia', name: 'Lic. Florencia Braglia', rol: 'Dirección Creativa', anos: '+10 años de experiencia' },
  { img: 'pereyra', name: 'Lic. Cecilia Pereyra', rol: 'Redacción Creativa Senior', anos: '+12 años de experiencia' },
  { img: 'fernandez', name: 'Lic. Ma. José Fernández', rol: 'Dirección de arte y diseño', anos: '+6 años de experiencia' },
  { img: 'quevedo', name: 'Marina Quevedo', rol: 'Dirección de proyectos', anos: '+17 años de experiencia' },
  { img: 'ruberti', name: 'Lic. Ma. Ruberti', rol: 'Project Manager', anos: '+9 años de experiencia' },
  { img: 'shaw', name: 'Moira Shaw', rol: 'Community Manager', anos: '+20 años de experiencia' },
];
---
<section id="equipo" class="py-2xl bg-paper">
  <div class="mx-auto max-w-[1240px] px-6">
    <p class="reveal font-bold text-eyebrow uppercase text-muted mb-5">Equipo</p>
    <h2 class="reveal font-bold text-h2 mb-6">Hacemos que las cosas <em>pasen.</em></h2>
    <p class="reveal max-w-[680px] text-muted text-[1.05rem]">
      Combinamos creatividad con contenido técnico. Un equipo multidisciplinario, con alto nivel de
      formación, que garantiza la calidad y profundidad de lo que hacemos. El trabajo en equipo es
      parte de nuestra forma de hacer, incorporando los talentos de la agencia y del equipo de la
      organización cliente — quienes lideran Alva participan del trabajo cotidiano.
    </p>

    <div class="reveal grid grid-cols-2 md:grid-cols-4 gap-x-7 gap-y-8 mt-14">
      {team.map(p => (
        <div class="group">
          <div class="aspect-[4/5] rounded-md overflow-hidden bg-paper-dim mb-4">
            <img src={`/img/alva/team/${p.img}.jpg`} alt={p.name} loading="lazy" width="480" height="377" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-[filter] duration-500" />
          </div>
          <h3 class="text-[1.02rem] font-bold leading-snug mb-1">{p.name}</h3>
          <p class="text-sm mb-1">{p.rol}</p>
          <p class="text-[.82rem] text-muted">{p.anos}</p>
        </div>
      ))}
    </div>

    <CtaHablemos variant="light" align="right" />
  </div>
</section>
