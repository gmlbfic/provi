---
import { Image } from 'astro:assets';
import { awards } from '../data/site';

// Una o varias imágenes de reconocimientos. Si hay una sola, se muestra fija.
// Si hay más de una, rotan con un fundido lento. Para sumar/sacar imágenes,
// solo hace falta agregar o quitar archivos en src/assets/awards/rotation/
// (el nombre del archivo define el orden: 01-..., 02-..., etc.).
const images = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/awards/rotation/*.{png,jpg,jpeg,webp}',
    { eager: true }
  )
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<section id="reconocimientos" class="border-b border-paper/10 bg-ink py-20 text-paper md:py-28">
  <div class="container-alva">
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-12 md:gap-8">
      <div class="fade-up md:col-span-5">
        <p class="eyebrow mb-6 text-gold">{awards.heading}</p>
        <p class="max-w-sm font-display text-xl leading-relaxed text-paper/75 md:text-2xl">
          {awards.text}
        </p>
      </div>

      <div class="fade-up md:col-span-7">
        <div class="award-rotator relative flex aspect-[16/10] items-center justify-center overflow-hidden border border-paper/10 bg-paper/[0.03]">
          {images.map((image, i) => (
            <Image
              src={image}
              alt="Reconocimiento obtenido por Alva"
              width={520}
              height={520}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="award-slide absolute inset-0 h-full w-full object-contain p-10 drop-shadow-[0_0_40px_rgba(198,161,91,0.15)] transition-opacity duration-1000 ease-alva"
              style={`opacity: ${i === 0 ? 1 : 0}`}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('.award-rotator').forEach((rotator) => {
      const slides = Array.from(rotator.querySelectorAll<HTMLElement>('.award-slide'));
      if (slides.length < 2) return;
      let current = 0;
      setInterval(() => {
        const next = (current + 1) % slides.length;
        slides[current].style.opacity = '0';
        slides[next].style.opacity = '1';
        current = next;
      }, 4500);
    });
  }
</script>
