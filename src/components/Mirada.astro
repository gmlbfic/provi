---
import { mirada } from '../data/site';

const icons = [
  // Mirada social — dos personas
  `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="10" r="4.2"/><path d="M4 27c0-5.2 3.4-8.6 8-8.6s8 3.4 8 8.6"/><circle cx="23" cy="13" r="3.2" opacity=".6"/><path d="M28 27c0-4-2.4-6.6-5.5-6.9" opacity=".6"/></svg>`,
  // Mirada de género y diversidad — círculos superpuestos
  `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="16" r="8.5"/><circle cx="20" cy="16" r="8.5" opacity=".6"/></svg>`,
  // Mirada sostenible — ciclo
  `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 14a10 10 0 0 1 17.3-6.8M26 18a10 10 0 0 1-17.3 6.8"/><path d="M23.3 3.6v4.6h-4.6M8.7 28.4v-4.6h4.6"/></svg>`,
];
---

<section id="mirada" class="bg-ink py-20 text-paper md:py-28">
  <div class="container-alva">
    <div class="fade-up mb-14 max-w-xl md:mb-20">
      <p class="eyebrow mb-4 text-paper/50">{mirada.heading}</p>
      <p class="font-display text-2xl leading-snug text-paper/80 md:text-3xl">{mirada.intro}</p>
    </div>

    <ul class="divide-y divide-paper/15 border-y border-paper/15">
      {mirada.items.map((item, i) => (
        <li class="fade-up group grid grid-cols-1 items-center gap-4 py-8 transition-colors duration-500 ease-alva hover:bg-paper/[0.03] md:grid-cols-12 md:gap-6 md:py-10">
          <div class="h-9 w-9 text-pink md:col-span-1" set:html={icons[i]} />
          <h3 class="font-display text-3xl font-medium leading-none tracking-tightest md:col-span-4 md:text-5xl">
            {item.name}
          </h3>
          <p class="max-w-sm font-display text-base text-paper/65 md:col-span-7 md:text-right md:text-lg">
            {item.text}
          </p>
        </li>
      ))}
    </ul>

    <div class="fade-up mt-14 max-w-2xl md:mt-20">
      <p class="eyebrow mb-3 text-pink">{mirada.purposeLabel}</p>
      <p class="font-serif text-3xl italic leading-snug text-paper md:text-4xl">{mirada.purpose}</p>
    </div>
  </div>
</section>
