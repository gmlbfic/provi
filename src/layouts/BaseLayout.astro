---
import '../styles/global.css';
import { siteMeta, socials } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteMeta.name} — Agencia de comunicación y publicidad`,
  description = siteMeta.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const mapsLink = socials.find((s) => s.icon === 'pin')?.href;
const socialProfiles = socials.filter((s) => s.icon !== 'pin').map((s) => s.href);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: siteMeta.fullName,
  alternateName: siteMeta.name,
  url: siteMeta.url,
  logo: new URL('/icon-512.png', Astro.site).toString(),
  image: new URL('/og-image.png', Astro.site).toString(),
  description: siteMeta.description,
  email: siteMeta.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteMeta.locality,
    addressCountry: siteMeta.countryCode,
  },
  areaServed: siteMeta.country,
  hasMap: mapsLink,
  sameAs: socialProfiles,
};
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- Geo / local -->
    <meta name="geo.placename" content={`${siteMeta.locality}, ${siteMeta.country}`} />
    <meta name="geo.region" content={`${siteMeta.countryCode}-MO`} />
    <meta name="ICBM" content="-34.9011, -56.1645" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.fade-up').forEach((el) => {
          el.classList.add('fade-init');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: #c6a15b;
    color: #0a0a0a;
    padding: 0.75rem 1.25rem;
    font-family: 'Onest', sans-serif;
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
