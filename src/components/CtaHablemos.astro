---
interface Props {
  variant?: 'light' | 'dark' | 'accent';
  align?: 'left' | 'right';
  label?: string;
  class?: string;
}
const { variant = 'light', align = 'left', label = 'Hablemos', class: cls = '' } = Astro.props;

const styles: Record<string, string> = {
  light: 'border border-ink/25 text-[#17171a] hover:bg-ink hover:text-white hover:border-ink',
  dark: 'border border-white/30 text-white hover:bg-white hover:text-ink',
  accent: 'bg-ink text-white hover:bg-black',
};
---
<div class:list={["mt-lg flex", align === 'right' ? 'justify-end' : 'justify-start', cls]}>
  <a
    href="#contacto"
    class:list={[
      "group inline-flex items-center gap-3 rounded-full px-7 py-3.5 text-sm font-bold transition-all duration-300",
      styles[variant],
    ]}
  >
    {label}
    <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
  </a>
</div>
