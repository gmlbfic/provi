---
import LoopThread from './LoopThread.astro';

const privados = [
  'BID', 'Tumo', 'ONU Mujeres', 'Proyecto Elsie', 'Unicef', 'Pacto Global Red Uruguay',
  'Nestlé', 'Nespresso', 'Warner Bros', 'SUAT', 'Forbes', 'Megalabs',
  'Comisión Honoraria para la Salud Cardiovascular', 'Banque Heritage', 'Arcor', 'Aguila',
  'Red Hat', 'AIVA', 'Fe y Alegría Uruguay', 'Casa Zorrilla', 'Carve 850', 'La 1010',
  'Monte Carlo', 'Radiocero', 'La Pasiva', 'Braglia', 'Vinoteca Club', 'Mercant & Esteves',
  'Castellán', 'Eyecue', 'Paullier', 'OMEU', 'Prolesa', 'BASF', 'Gerdau', 'Amnistía Internacional',
];

const publicos = [
  'Ministerio de Industria, Energía y Minería', 'Eficiencia Energética', 'Ministerio de Desarrollo Social',
  'Ministerio del Interior', 'DCAF', 'Ministerio de Transporte y Obras Públicas',
  'Ministerio de Salud Pública', 'Ministerio de Ambiente', 'Ministerio de Ganadería, Agricultura y Pesca',
  'Cámara de Industrias del Uruguay', 'Plan Vale Uruguay', 'Uruguay XXI', 'ANII', 'INIA', 'UTEC',
  'UNASEV', 'OPS', 'Correo Uruguayo', 'Fondo Nacional de Recursos', 'Movés',
  'Intendencia de Montevideo', 'ECH', 'Uruguay Innovation Hub',
];

const sizeAt = (i: number) => (i % 5 === 0 ? 'text-xl sm:text-2xl font-serif italic font-medium' : i % 3 === 0 ? 'text-base sm:text-lg font-bold' : 'text-sm sm:text-base font-semibold text-dark-muted');
---
<section id="clientes" class="relative overflow-hidden py-2xl bg-ink text-paper">
  <LoopThread class="left-[-90px] bottom-[-40px] w-[220px] h-[480px] opacity-[0.1]" flip />
  <div class="relative mx-auto max-w-[1240px] px-6">
    <p class="reveal font-semibold text-eyebrow uppercase text-dark-muted mb-3">Clientes</p>
    <h2 class="reveal font-bold text-h3 max-w-[620px] mb-md">Confían en nosotros marcas, empresas y organismos <em>de distintos sectores.</em></h2>

    <div class="reveal flex gap-2.5 flex-wrap mb-9" role="tablist" aria-label="Grupos de clientes">
      <button class="clientes-tab is-active rounded-full px-5.5 py-3 font-bold text-sm bg-red text-white transition-colors duration-300" role="tab" aria-selected="true" data-target="clientes-privados">Marcas y organizaciones</button>
      <button class="clientes-tab rounded-full px-5.5 py-3 font-bold text-sm border border-white/20 text-dark-muted transition-colors duration-300" role="tab" aria-selected="false" data-target="clientes-publicos">Organismos públicos</button>
    </div>

    <div class="reveal">
      <div class="clientes-panel border border-white/15 rounded-2xl overflow-hidden" id="clientes-privados" role="tabpanel">
        <div class="flex flex-wrap">
          {privados.map((name, i) => (
            <span class={`client-chip px-4 py-3.5 border-r border-b border-white/10 leading-tight ${sizeAt(i)}`}>{name}</span>
          ))}
        </div>
      </div>
      <div class="clientes-panel border border-white/15 rounded-2xl overflow-hidden" id="clientes-publicos" role="tabpanel" hidden>
        <div class="flex flex-wrap">
          {publicos.map((name, i) => (
            <span class={`client-chip px-4 py-3.5 border-r border-b border-white/10 leading-tight ${sizeAt(i)}`}>{name}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
