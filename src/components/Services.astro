---
import { services } from '../data/site';
---

<section id="servicios" class="bg-ink py-20 text-paper md:py-28">
  <div class="container-alva">
    <p class="fade-up eyebrow mb-14 md:mb-16">{services.heading}</p>

    <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {services.groups.map((group) => (
        <div class="fade-up border-t border-paper/20 pt-5">
          <h3 class="font-display text-xl font-medium tracking-tightest md:text-2xl">
            {group.name}
          </h3>
          <ul class="mt-5 space-y-2.5">
            {group.items.map((item) => (
              <li class="font-display text-sm leading-snug text-paper/60 md:text-[15px]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
